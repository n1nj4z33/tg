# local — вся игра работает в браузере, сохранение в localStorage (удобно для разработки).
# remote — состояние хранится на сервере (apps/server), авторизация через Telegram initData.
VITE_API_MODE=local
# Адрес сервера в remote-режиме. Пусто — тот же origin (сервер раздаёт фронт сам).
VITE_API_URL=
# Только для отладки remote-режима вне Telegram: id тестового игрока (сервер с DEV_AUTH=1).
VITE_DEV_USER=
